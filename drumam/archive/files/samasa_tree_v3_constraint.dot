// ВАРИАНТ v3: constraint=false на «да»-листьях
// Делаем "да"-рёбра к листьям не влияющими на layout. Тогда листья
// "прилипают" к своим родителям, но не раздвигают основную цепь.
digraph samasa_tree {
  rankdir=LR;
  splines=spline;
  nodesep=0.12;
  ranksep=0.28;
  bgcolor="white";
  node [fontname="Arial" fontsize=10 shape=box style="filled,rounded" margin="0.10,0.05"];
  edge [fontname="Arial" fontsize=9];

  // ── ВОПРОСЫ ──────────────────────────────────────────
  q_avyaya [label="Итог = наречие?\nacc.sg.nt." fillcolor="#eaf4ee" color="#2d6a4f" fontcolor="#1e4a37"];
  q_dvandva [label="«И/и» между частями?" fillcolor="#eaf4ee" color="#2d6a4f" fontcolor="#1e4a37"];
  q_dv_type [label="Совокупность?" fillcolor="#eaf4ee" color="#2d6a4f" fontcolor="#1e4a37"];
  q_same_case [label="Обе части в одном падеже?" fillcolor="#eaf4ee" color="#2d6a4f" fontcolor="#1e4a37"];
  q_km_type [label="Подтип K?" fillcolor="#eaf4ee" color="#2d6a4f" fontcolor="#1e4a37"];
  q_bv_role [label="Атрибут внеш. слова?" fillcolor="#eaf4ee" color="#2d6a4f" fontcolor="#1e4a37"];
  q_bv_sub [label="sa- / prādi- / обычн?" fillcolor="#eaf4ee" color="#2d6a4f" fontcolor="#1e4a37"];
  q_upapada [label="Kṛt-суфф. справа?" fillcolor="#eaf4ee" color="#2d6a4f" fontcolor="#1e4a37"];
  q_numeral [label="Числит. слева?" fillcolor="#eaf4ee" color="#2d6a4f" fontcolor="#1e4a37"];
  q_prefix [label="Преверб prādi/gati?" fillcolor="#eaf4ee" color="#2d6a4f" fontcolor="#1e4a37"];
  q_aluk [label="Aluk (падеж сохр.)?" fillcolor="#eaf4ee" color="#2d6a4f" fontcolor="#1e4a37"];
  q_case [label="Падеж виграхи?" fillcolor="#eaf4ee" color="#2d6a4f" fontcolor="#1e4a37"];

  // ── РЕЗУЛЬТАТЫ ───────────────────────────────────────
  r_avyayi [label="avyayībhāva\nA1 · 2.4%" fillcolor="#fff9c4" color="#fbc02d" fontcolor="#5a4a00"];
  r_dv_samahara [label="samāhāra-dv.\nDs · ~3%" fillcolor="#fff9c4" color="#fbc02d" fontcolor="#5a4a00"];
  r_dv_itaretara [label="itaretara-dv.\nDi · ~9%" fillcolor="#fff9c4" color="#fbc02d" fontcolor="#5a4a00"];
  r_km_adj [label="viśeṣaṇapūrvap.-K\nK1 · 12.29%" fillcolor="#ffcdd2" color="#c62828" fontcolor="#7f0000"];
  r_km_appos [label="viśeṣyapūrvap.-K\nK2 · низкая" fillcolor="#f5f5f5" color="#9e9e9e" fontcolor="#424242"];
  r_km_upamana [label="upamāna pūrv.-K\nK4 · низкая" fillcolor="#f5f5f5" color="#9e9e9e" fontcolor="#424242"];
  r_km_rupaka [label="rūpaka / avadh.\nK6 · низкая" fillcolor="#f5f5f5" color="#9e9e9e" fontcolor="#424242"];
  r_km_ubhaya [label="ubhayapada-K\nK3 · низкая" fillcolor="#f5f5f5" color="#9e9e9e" fontcolor="#424242"];
  r_km_sambhavana [label="sambhāvanā-K\nK7 · оч. низк." fillcolor="#f5f5f5" color="#9e9e9e" fontcolor="#424242"];
  r_km_madhyama [label="madhyamapadalopi\nKm · оч. низк." fillcolor="#f5f5f5" color="#9e9e9e" fontcolor="#424242"];
  r_bv_reg [label="bahuvrīhi (обычн.)\nBs6 · 6.39%" fillcolor="#ffe0b2" color="#e65100" fontcolor="#5a2e00"];
  r_bv_saha [label="saha-bahuvrīhi\nBvS · низк." fillcolor="#f5f5f5" color="#9e9e9e" fontcolor="#424242"];
  r_bv_pradi [label="prādi-bahuvrīhi\nBp  · низк." fillcolor="#f5f5f5" color="#9e9e9e" fontcolor="#424242"];
  r_upapada [label="upapada-tp\nU · 4.32%" fillcolor="#fff9c4" color="#fbc02d" fontcolor="#5a4a00"];
  r_dvigu [label="dvigu\nTd · низк." fillcolor="#f5f5f5" color="#9e9e9e" fontcolor="#424242"];
  r_pradi [label="prādi/gati-tp\nTp/Tg · низк." fillcolor="#f5f5f5" color="#9e9e9e" fontcolor="#424242"];
  r_aluk [label="aluk-samāsa\nоч. низк." fillcolor="#f5f5f5" color="#9e9e9e" fontcolor="#424242"];
  r_tp_gen [label="ṣaṣṭhī-tp\nT6 · 40.56%" fillcolor="#ffcdd2" color="#c62828" fontcolor="#7f0000"];
  r_tp_nan [label="nañ-tp\nTn · 5.9% F=99%" fillcolor="#ffe0b2" color="#e65100" fontcolor="#5a2e00"];
  r_tp_acc [label="dvitīyā-tp\nT2 · 2–5%" fillcolor="#fff9c4" color="#fbc02d" fontcolor="#5a4a00"];
  r_tp_dat [label="caturthī-tp\nT4 · ~1.6% F=87%" fillcolor="#fff9c4" color="#fbc02d" fontcolor="#5a4a00"];
  r_tp_abl [label="pañcamī-tp\nT5 · <2%" fillcolor="#f5f5f5" color="#9e9e9e" fontcolor="#424242"];
  r_tp_inst [label="tṛtīyā-tp\nT3 · ~1% F=5%" fillcolor="#f5f5f5" color="#9e9e9e" fontcolor="#424242"];
  r_tp_loc [label="saptamī-tp\nT7 · <1% F=1%" fillcolor="#f5f5f5" color="#9e9e9e" fontcolor="#424242"];


  // ── РЁБРА ────────────────────────────────────────────
  // Главная «нет»-цепь — жирный вес, чтобы была ровной
  q_avyaya -> q_dvandva [color="#a04020" style=dashed penwidth=1.5 weight=10 label="нет"];
  q_dvandva -> q_same_case [color="#a04020" style=dashed penwidth=1.5 weight=10 label="нет"];
  q_same_case -> q_bv_role [color="#a04020" style=dashed penwidth=1.5 weight=10 label="нет"];
  q_bv_role -> q_upapada [color="#a04020" style=dashed penwidth=1.5 weight=10 label="нет"];
  q_upapada -> q_numeral [color="#a04020" style=dashed penwidth=1.5 weight=10 label="нет"];
  q_numeral -> q_prefix [color="#a04020" style=dashed penwidth=1.5 weight=10 label="нет"];
  q_prefix -> q_aluk [color="#a04020" style=dashed penwidth=1.5 weight=10 label="нет"];
  q_aluk -> q_case [color="#a04020" style=dashed penwidth=1.5 weight=10 label="нет"];

  // «да»-листья — НЕ влияют на layout
  q_avyaya -> r_avyayi [color="#2d6a4f" penwidth=1.5 label="да" constraint=false];
  q_dv_type -> r_dv_samahara [color="#2d6a4f" penwidth=1.5 label="да" constraint=false];
  q_dv_type -> r_dv_itaretara [color="#a04020" style=dashed penwidth=1.3 label="нет" constraint=false];
  q_upapada -> r_upapada [color="#2d6a4f" penwidth=1.5 label="да" constraint=false];
  q_numeral -> r_dvigu [color="#2d6a4f" penwidth=1.5 label="да" constraint=false];
  q_prefix -> r_pradi [color="#2d6a4f" penwidth=1.5 label="да" constraint=false];
  q_aluk -> r_aluk [color="#2d6a4f" penwidth=1.5 label="да" constraint=false];

  // Остальные «да»-рёбра (хабы с выбором и т.д.) — стандарт
  q_dvandva -> q_dv_type [color="#2d6a4f" penwidth=1.5 label="да"];
  q_same_case -> q_km_type [color="#2d6a4f" penwidth=1.5 label="да"];
  q_bv_role -> q_bv_sub [color="#2d6a4f" penwidth=1.5 label="да"];

  // K-хаб
  q_km_type -> r_km_adj [color="#888888" style=dotted];
  q_km_type -> r_km_appos [color="#888888" style=dotted];
  q_km_type -> r_km_upamana [color="#888888" style=dotted];
  q_km_type -> r_km_rupaka [color="#888888" style=dotted];
  q_km_type -> r_km_ubhaya [color="#888888" style=dotted];
  q_km_type -> r_km_sambhavana [color="#888888" style=dotted];
  q_km_type -> r_km_madhyama [color="#888888" style=dotted];

  // bv-хаб
  q_bv_sub -> r_bv_reg [color="#888888" style=dotted label="обычн"];
  q_bv_sub -> r_bv_saha [color="#888888" style=dotted label="sa-"];
  q_bv_sub -> r_bv_pradi [color="#888888" style=dotted label="prādi"];

  // Падежный хаб
  q_case -> r_tp_gen [color="#888888" style=dotted];
  q_case -> r_tp_nan [color="#888888" style=dotted];
  q_case -> r_tp_acc [color="#888888" style=dotted];
  q_case -> r_tp_dat [color="#888888" style=dotted];
  q_case -> r_tp_abl [color="#888888" style=dotted];
  q_case -> r_tp_inst [color="#888888" style=dotted];
  q_case -> r_tp_loc [color="#888888" style=dotted];
}
